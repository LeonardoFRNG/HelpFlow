                  "});",
                  "const ticket = pm.response.json();",
                  "pm.collectionVariables.set('ticketId', ticket.id);",
                  "pm.expect(ticket.status).to.be.oneOf(['OPEN', 'ASSIGNED']);",
                  "pm.expect(ticket.slaDeadline).to.not.be.null;"
