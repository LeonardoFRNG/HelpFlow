COMPOSE_PROJECT_NAME=helpflow

# Database Configuration
POSTGRES_DB=helpflow_db
POSTGRES_USER=helpflow
POSTGRES_PASSWORD=helpflow_secret
DB_PORT=5434

# Services Port Mapping
APP_PORT=8080
DISPATCH_PORT=8081

# JWT Security
JWT_SECRET=helpflow-super-secret-jwt-signing-key-for-production-grade-security-at-least-256-bits!
JWT_EXPIRATION_MS=900000
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# SLA Policy and Monitoring
SLA_CHECK_CRON=0 */5 * * * *
SLA_THRESHOLD_MINUTES=30
